run [--uninstall --skip-packages]: exit 2
harness install: --uninstall and --skip-packages are contradictory; --uninstall removes every link.
run [--clear-backups --uninstall]: exit 2
harness install: --clear-backups runs on its own; it neither installs nor uninstalls.
run [--skip-packages --clear-backups]: exit 2
harness install: --clear-backups runs on its own; it neither installs nor uninstalls.
run [--bogus]: exit 2
harness install: unknown argument "--bogus"; run harness install --help
== commands
== home
D .local
D .local/bin
F .local/bin/harness
  |#!/bin/sh
  |
