run [--skip-packages --no-backup]: exit 0
== commands
engram setup claude-code <y>
engram setup opencode <>
claude mcp remove --scope user agent-browser <>
claude mcp add --scope user agent-browser -- $SHIMS/agent-browser mcp <>
== home
D .agent-browser
D .agent-browser/browsers
F .agent-browser/browsers/chrome
  |browser
  |
D .agents
D .agents/skills
L .agents/skills/adversarial-review -> $CHECKOUT/skills/adversarial-review
L .agents/skills/caveman-commit -> $CHECKOUT/skills/caveman-commit
L .agents/skills/codebase-design -> $CHECKOUT/skills/codebase-design
L .agents/skills/diagnosing-bugs -> $CHECKOUT/skills/diagnosing-bugs
L .agents/skills/domain-modeling -> $CHECKOUT/skills/domain-modeling
L .agents/skills/evidence -> $CHECKOUT/skills/evidence
L .agents/skills/grill-with-docs -> $CHECKOUT/skills/grill-with-docs
L .agents/skills/grilling -> $CHECKOUT/skills/grilling
L .agents/skills/handoff -> $CHECKOUT/skills/handoff
L .agents/skills/impeccable -> $CHECKOUT/skills/impeccable
L .agents/skills/improve-codebase-architecture -> $CHECKOUT/skills/improve-codebase-architecture
L .agents/skills/local-tracker -> $CHECKOUT/skills/local-tracker
L .agents/skills/ponytail -> $CHECKOUT/skills/ponytail
L .agents/skills/resolving-merge-conflicts -> $CHECKOUT/skills/resolving-merge-conflicts
L .agents/skills/setup-harness -> $CHECKOUT/skills/setup-harness
L .agents/skills/tdd -> $CHECKOUT/skills/tdd
L .agents/skills/workflow-checkpoint -> $CHECKOUT/skills/workflow-checkpoint
D .claude
L .claude/CLAUDE.md -> $CHECKOUT/POLICY.md
D .claude/agents
L .claude/agents/executor.md -> $CHECKOUT/.generated/agents/claude/executor.md
F .claude/agents/mine.md
  |private agent
  |
L .claude/agents/review-refuter.md -> $CHECKOUT/.generated/agents/claude/review-refuter.md
L .claude/agents/reviewer-a.md -> $CHECKOUT/.generated/agents/claude/reviewer-a.md
L .claude/agents/reviewer-b.md -> $CHECKOUT/.generated/agents/claude/reviewer-b.md
D .claude/commands
L .claude/commands/abandon.md -> $CHECKOUT/commands/abandon.md
L .claude/commands/address-review.md -> $CHECKOUT/commands/address-review.md
L .claude/commands/ask.md -> $CHECKOUT/commands/ask.md
L .claude/commands/create-ticket.md -> $CHECKOUT/commands/create-ticket.md
L .claude/commands/feedback.md -> $CHECKOUT/commands/feedback.md
L .claude/commands/harness-audit.md -> $CHECKOUT/commands/harness-audit.md
L .claude/commands/land.md -> $CHECKOUT/commands/land.md
L .claude/commands/proto.md -> $CHECKOUT/commands/proto.md
L .claude/commands/research.md -> $CHECKOUT/commands/research.md
L .claude/commands/ship.md -> $CHECKOUT/commands/ship.md
L .claude/commands/spec.md -> $CHECKOUT/commands/spec.md
L .claude/commands/triage.md -> $CHECKOUT/commands/triage.md
D .claude/mcp
F .claude/mcp/engram.json
  |{}
  |
F .claude/settings.json
  |{
  |  "env": {
  |    "KEEP": "caf\u00e9"
  |  },
  |  "model": "opus",
  |  "permissions": {
  |    "allow": [
  |      "mcp__plugin_engram_engram__mem_save",
  |      "Bash(cd ~/src/engram && cargo test)"
  |    ],
  |    "deny": [
  |      "Read(**/.env*)",
  |      "Read(**/.dev.vars*)",
  |      "Read(**/*.pem)",
  |      "Read(**/*.key)",
  |      "Read(**/secrets/**)",
  |      "Read(**/credentials/**)",
  |      "Read(**/.aws/**)",
  |      "Read(**/.ssh/**)",
  |      "Read(**/config/database.yml)",
  |      "Read(**/config/credentials.json)",
  |      "Read(**/.npmrc)",
  |      "Read(**/.pypirc)",
  |      "Edit(**/.env*)",
  |      "Edit(**/secrets/**)",
  |      "Edit(**/.ssh/**)",
  |      "Bash(git reset --hard:*)",
  |      "Bash(git reset --keep:*)",
  |      "Bash(git clean:*)",
  |      "Bash(git checkout --:*)",
  |      "Bash(git checkout -f:*)",
  |      "Bash(git restore:*)",
  |      "Bash(git worktree remove:*)",
  |      "Bash(git worktree prune:*)",
  |      "Bash(git push --force:*)",
  |      "Bash(git push -f:*)"
  |    ],
  |    "defaultMode": "plan"
  |  },
  |  "enabledPlugins": {
  |    "engram@engram": true,
  |    "other@market": true
  |  },
  |  "extraKnownMarketplaces": {
  |    "engram": {},
  |    "market": {}
  |  },
  |  "effortLevel": "medium",
  |  "theme": "dark-ansi",
  |  "remoteControlAtStartup": false,
  |  "skipDangerousModePermissionPrompt": true,
  |  "skipAutoPermissionPrompt": true,
  |  "statusLine": {
  |    "type": "command",
  |    "command": "\"$HOME/.local/bin/harness\" statusline"
  |  }
  |}
  |
D .claude/skills
L .claude/skills/adversarial-review -> $CHECKOUT/skills/adversarial-review
L .claude/skills/caveman-commit -> $CHECKOUT/skills/caveman-commit
L .claude/skills/codebase-design -> $CHECKOUT/skills/codebase-design
L .claude/skills/diagnosing-bugs -> $CHECKOUT/skills/diagnosing-bugs
L .claude/skills/domain-modeling -> $CHECKOUT/skills/domain-modeling
L .claude/skills/evidence -> $CHECKOUT/skills/evidence
L .claude/skills/grill-with-docs -> $CHECKOUT/skills/grill-with-docs
L .claude/skills/grilling -> $CHECKOUT/skills/grilling
L .claude/skills/handoff -> $CHECKOUT/skills/handoff
L .claude/skills/impeccable -> $CHECKOUT/skills/impeccable
L .claude/skills/improve-codebase-architecture -> $CHECKOUT/skills/improve-codebase-architecture
L .claude/skills/local-tracker -> $CHECKOUT/skills/local-tracker
D .claude/skills/mine
F .claude/skills/mine/SKILL.md
  |private skill
  |
L .claude/skills/ponytail -> $CHECKOUT/skills/ponytail
L .claude/skills/resolving-merge-conflicts -> $CHECKOUT/skills/resolving-merge-conflicts
L .claude/skills/setup-harness -> $CHECKOUT/skills/setup-harness
L .claude/skills/tdd -> $CHECKOUT/skills/tdd
L .claude/skills/workflow-checkpoint -> $CHECKOUT/skills/workflow-checkpoint
F .claude.json
  |{"mcpServers": {"other": {}}}
  |
D .config
D .config/opencode
L .config/opencode/AGENTS.md -> $CHECKOUT/POLICY.md
D .config/opencode/agents
L .config/opencode/agents/executor.md -> $CHECKOUT/.generated/agents/opencode/executor.md
L .config/opencode/agents/review-refuter.md -> $CHECKOUT/.generated/agents/opencode/review-refuter.md
L .config/opencode/agents/reviewer-a.md -> $CHECKOUT/.generated/agents/opencode/reviewer-a.md
L .config/opencode/agents/reviewer-b.md -> $CHECKOUT/.generated/agents/opencode/reviewer-b.md
D .config/opencode/command
L .config/opencode/command/abandon.md -> $CHECKOUT/commands/abandon.md
L .config/opencode/command/address-review.md -> $CHECKOUT/commands/address-review.md
L .config/opencode/command/ask.md -> $CHECKOUT/commands/ask.md
L .config/opencode/command/create-ticket.md -> $CHECKOUT/commands/create-ticket.md
L .config/opencode/command/feedback.md -> $CHECKOUT/commands/feedback.md
L .config/opencode/command/harness-audit.md -> $CHECKOUT/commands/harness-audit.md
L .config/opencode/command/land.md -> $CHECKOUT/commands/land.md
L .config/opencode/command/proto.md -> $CHECKOUT/commands/proto.md
L .config/opencode/command/research.md -> $CHECKOUT/commands/research.md
L .config/opencode/command/ship.md -> $CHECKOUT/commands/ship.md
L .config/opencode/command/spec.md -> $CHECKOUT/commands/spec.md
L .config/opencode/command/triage.md -> $CHECKOUT/commands/triage.md
F .config/opencode/opencode.json
  |{
  |  "$schema": "https://opencode.ai/config.json",
  |  "agent": {
  |    "mine": {
  |      "model": "openai/gpt-5.5"
  |    }
  |  },
  |  "mcp": {
  |    "engram": {
  |      "type": "local"
  |    },
  |    "other": {
  |      "type": "remote"
  |    },
  |    "agent-browser": {
  |      "command": [
  |        "$SHIMS/agent-browser",
  |        "mcp"
  |      ],
  |      "enabled": true,
  |      "type": "local"
  |    }
  |  },
  |  "plugin": [
  |    "/x/plugins/engram.ts",
  |    "other-plugin"
  |  ]
  |}
  |
D .config/opencode/plugins
F .config/opencode/plugins/engram.ts
  |export {}
  |
D .config/opencode/skills
F .config/opencode/tui.json
  |{"plugin": ["opencode-subagent-statusline", "keep"]}
  |
D .dotfiles-backups
D .dotfiles-backups/other
F .dotfiles-backups/other/keep.txt
  |not the harness's
  |
D .engram
F .engram/engram.db
  |memories
  |
D .local
D .local/bin
F .local/bin/claude
  |#!/bin/sh
  |
F .local/bin/harness
  |#!/bin/sh
  |
D .local/share
D .local/share/claude
D .local/share/claude/versions
F .local/share/claude/versions/1
  |binary
  |
D .local/share/opencode
F .local/share/opencode/auth.json
  |{"openai": "private-secret"}
  |
F .zshrc
  |export KEEP=1
  |alias ll='ls -l'
  |# portable-harness aliases
  |[ -f "$CHECKOUT/aliases.sh" ] && source "$CHECKOUT/aliases.sh"
  |
== generated
D agents
D agents/claude
F agents/claude/executor.md
F agents/claude/review-refuter.md
F agents/claude/reviewer-a.md
F agents/claude/reviewer-b.md
D agents/opencode
F agents/opencode/executor.md
F agents/opencode/review-refuter.md
F agents/opencode/reviewer-a.md
F agents/opencode/reviewer-b.md
