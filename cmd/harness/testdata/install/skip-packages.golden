D .dotfiles-backups/harness/<stamp>/.local
D .dotfiles-backups/harness/<stamp>/.local/bin
F .dotfiles-backups/harness/<stamp>/.local/bin/claude-seo
  |#!/bin/sh
  |
F .dotfiles-backups/harness/<stamp>/.zshrc.pre-reconcile
  |export KEEP=1
  |alias ccyolo='claude'
  |alias ll='ls -l'
  |
  |
  |
D .dotfiles-backups/other
F .dotfiles-backups/other/keep.txt
