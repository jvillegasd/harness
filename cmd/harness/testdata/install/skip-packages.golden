  |{
  |  "$schema": "https://opencode.ai/config.json",
  |  "agent": {
  |    "mine": {
  |      "model": "openai/gpt-5.5"
  |    }
  |  },
  |  "mcp": {
  |    "engram": {
  |      "type": "local"
  |    },
  |    "other": {
  |      "type": "remote"
  |    },
  |    "agent-browser": {
  |      "command": [
  |        "$SHIMS/agent-browser",
  |        "mcp"
  |      ],
  |      "enabled": true,
  |      "type": "local"
  |    }
  |  },
  |  "plugin": [
  |    "/x/plugins/engram.ts",
  |    "other-plugin"
  |  ]
  |}
  |
D .config/opencode/plugins
F .config/opencode/plugins/engram.ts
  |export {}
  |
D .config/opencode/skills
F .config/opencode/tui.json
  |{"plugin": ["opencode-subagent-statusline", "keep"]}
  |
