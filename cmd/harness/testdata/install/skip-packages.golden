F .dotfiles-backups/harness/<stamp>/.claude/settings.json.pre-reconcile
  |{
  |  "env": {
  |    "KEEP": "café"
  |  },
  |  "model": "sonnet",
  |  "permissions": {
  |    "allow": [
  |      "mcp__plugin_engram_engram__mem_save",
  |      "Bash(cd ~/src/engram && cargo test)"
  |    ],
  |    "deny": [
  |      "Read(stale)"
  |    ],
  |    "defaultMode": "plan"
  |  },
