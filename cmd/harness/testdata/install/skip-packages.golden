C .claude/commands/land.md
C .claude/commands/proto.md
L .claude/commands/renamed.md -> $CHECKOUT/commands/ship.md
C .claude/commands/research.md
L .claude/commands/retired.md -> $CHECKOUT/commands/retired.md
C .claude/commands/ship.md
C .claude/commands/spec.md
C .claude/commands/triage.md
D .claude/mcp
F .claude/mcp/engram.json
  |{}
  |
F .claude/settings.json
  |{
  |  "env": {
  |    "KEEP": "caf\u00e9"
  |  },
  |  "model": "opus",
  |  "permissions": {
  |    "allow": [
  |      "mcp__plugin_engram_engram__mem_save",
  |      "Bash(cd ~/src/engram && cargo test)"
  |    ],
  |    "deny": [
  |      "Read(**/.env*)",
  |      "Read(**/.dev.vars*)",
  |      "Read(**/*.pem)",
  |      "Read(**/*.key)",
  |      "Read(**/secrets/**)",
  |      "Read(**/credentials/**)",
  |      "Read(**/.aws/**)",
  |      "Read(**/.ssh/**)",
  |      "Read(**/config/database.yml)",
  |      "Read(**/config/credentials.json)",
  |      "Read(**/.npmrc)",
  |      "Read(**/.pypirc)",
  |      "Edit(**/.env*)",
  |      "Edit(**/secrets/**)",
  |      "Edit(**/.ssh/**)",
  |      "Bash(git reset --hard:*)",
  |      "Bash(git reset --keep:*)",
  |      "Bash(git clean:*)",
  |      "Bash(git checkout --:*)",
  |      "Bash(git checkout -f:*)",
  |      "Bash(git restore:*)",
  |      "Bash(git worktree remove:*)",
  |      "Bash(git worktree prune:*)",
  |      "Bash(git push --force:*)",
  |      "Bash(git push -f:*)"
  |    ],
  |    "defaultMode": "plan"
  |  },
  |  "enabledPlugins": {
  |    "engram@engram": true,
  |    "other@market": true
  |  },
  |  "extraKnownMarketplaces": {
  |    "engram": {},
  |    "market": {}
  |  },
  |  "effortLevel": "medium",
  |  "theme": "dark-ansi",
  |  "remoteControlAtStartup": false,
  |  "skipDangerousModePermissionPrompt": true,
  |  "skipAutoPermissionPrompt": true,
  |  "statusLine": {
  |    "type": "command",
  |    "command": "\"$HOME/.local/bin/harness\" statusline"
  |  }
  |}
  |
