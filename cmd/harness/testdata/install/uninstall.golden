run [--skip-packages]: exit 0
run [--uninstall]: exit 0
== commands
engram setup claude-code <y>
engram setup opencode <>
claude mcp remove --scope user agent-browser <>
claude mcp add --scope user agent-browser -- $SHIMS/agent-browser mcp <>
claude plugin uninstall engram@engram <>
claude plugin marketplace remove engram <>
brew list --formula gentleman-programming/tap/engram <>
brew uninstall gentleman-programming/tap/engram <>
claude mcp remove --scope user agent-browser <>
brew list --formula agent-browser <>
brew uninstall agent-browser <>
brew list --formula <>
== home
D .claude
D .claude/agents
F .claude/agents/mine.md
  |private agent
  |
F .claude/settings.json
  |{
  |  "env": {
  |    "KEEP": "caf\u00e9"
  |  },
  |  "permissions": {
  |    "allow": [
  |      "Bash(cd ~/src/engram && cargo test)"
  |    ],
  |    "defaultMode": "plan"
  |  },
  |  "enabledPlugins": {
  |    "other@market": true
  |  },
  |  "extraKnownMarketplaces": {
  |    "market": {}
  |  }
  |}
  |
D .claude/skills
D .claude/skills/mine
F .claude/skills/mine/SKILL.md
  |private skill
  |
F .claude.json
  |{"mcpServers": {"other": {}}}
  |
D .config
D .config/opencode
F .config/opencode/opencode.json
  |{
  |  "$schema": "https://opencode.ai/config.json",
  |  "agent": {
  |    "mine": {
  |      "model": "openai/gpt-5.5"
  |    }
  |  },
  |  "mcp": {
  |    "other": {
  |      "type": "remote"
  |    }
  |  },
  |  "plugin": [
  |    "other-plugin"
  |  ]
  |}
  |
F .config/opencode/tui.json
  |{
  |  "plugin": [
  |    "keep"
  |  ]
  |}
  |
D .dotfiles-backups
D .dotfiles-backups/other
F .dotfiles-backups/other/keep.txt
  |not the harness's
  |
D .local
D .local/bin
F .local/bin/claude
  |#!/bin/sh
  |
D .local/share
D .local/share/claude
D .local/share/claude/versions
F .local/share/claude/versions/1
  |binary
  |
D .local/share/opencode
F .local/share/opencode/auth.json
  |{"openai": "private-secret"}
  |
F .zshrc
  |export KEEP=1
  |alias ll='ls -l'
  |
