{
  "permissions": {
    "allow": [
      "Read(~/.claude/skills/**)"
    ],
    "deny": [
      "Read(//**/.dev.vars*)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/secrets/**)",
      "Read(//**/credentials/**)",
      "Read(//**/.aws/**)",
      "Read(//**/.ssh/**)",
      "Read(//**/config/database.yml)",
      "Read(//**/config/credentials.json)",
      "Read(//**/.npmrc)",
      "Read(//**/.pypirc)",
      "Edit(//**/secrets/**)",
      "Edit(//**/.ssh/**)",
      "Bash(git reset --hard:*)",
      "Bash(git reset --keep:*)",
      "Bash(git clean:*)",
      "Bash(git checkout --:*)",
      "Bash(git checkout -f:*)",
      "Bash(git restore:*)",
      "Bash(git worktree prune:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(harness review level off:*)",
      "Bash(harness review level medium:*)",
      "Bash(harness review level high:*)"
    ],
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(git worktree remove --force:*)",
      "Bash(git worktree remove -f:*)"
    ]
  },
  "model": "opus",
  "effortLevel": "medium",
  "theme": "dark-ansi",
  "remoteControlAtStartup": false,
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "statusLine": {
    "type": "command",
    "command": "\"$HOME/.local/bin/harness\" statusline"
  },
  "skillOverrides": {
    "animate": "user-invocable-only",
    "animate-expo": "user-invocable-only",
    "animation-performance": "user-invocable-only",
    "animation-vocabulary": "user-invocable-only",
    "apple-design": "user-invocable-only",
    "ask-emil": "user-invocable-only",
    "ask-sonner": "user-invocable-only",
    "break-ui": "user-invocable-only",
    "caveman-commit": "name-only",
    "choreograph": "user-invocable-only",
    "codebase-design": "name-only",
    "diagnosing-bugs": "user-invocable-only",
    "domain-modeling": "name-only",
    "emil-design-eng": "user-invocable-only",
    "find-animation-opportunities": "user-invocable-only",
    "gestures": "user-invocable-only",
    "grilling": "name-only",
    "impeccable": "user-invocable-only",
    "improve-animations": "user-invocable-only",
    "learn-taste": "user-invocable-only",
    "mobile-native": "user-invocable-only",
    "pick-ui-library": "user-invocable-only",
    "prototype": "user-invocable-only",
    "remove-animations": "user-invocable-only",
    "review-animations": "user-invocable-only",
    "security-audit": "user-invocable-only",
    "tdd": "user-invocable-only",
    "write-swift": "user-invocable-only",
    "writing-for-agents": "user-invocable-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/harness\" models secret-guard || exit 2"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/harness\" resume"
          }
        ]
      }
    ]
  }
}
