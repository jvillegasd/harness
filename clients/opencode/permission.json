{
  "read": {
    ".env*": "deny",
    "*/.env*": "deny",
    ".dev.vars*": "deny",
    "*/.dev.vars*": "deny",
    "*.pem": "deny",
    "*.key": "deny",
    "secrets/*": "deny",
    "*/secrets/*": "deny",
    "credentials/*": "deny",
    "*/credentials/*": "deny",
    "*/.aws/*": "deny",
    "*/.ssh/*": "deny",
    "config/database.yml": "deny",
    "*/config/database.yml": "deny",
    "config/credentials.json": "deny",
    "*/config/credentials.json": "deny",
    ".npmrc": "deny",
    "*/.npmrc": "deny",
    ".pypirc": "deny",
    "*/.pypirc": "deny"
  },
  "edit": {
    ".env*": "deny",
    "*/.env*": "deny",
    "secrets/*": "deny",
    "*/secrets/*": "deny",
    "*/.ssh/*": "deny"
  },
  "bash": {
    "git reset --hard *": "deny",
    "git reset --keep *": "deny",
    "git clean *": "deny",
    "git checkout -- *": "deny",
    "git checkout -f *": "deny",
    "git restore *": "deny",
    "git worktree prune *": "deny",
    "git push --force *": "deny",
    "git push -f *": "deny",
    "harness review level off *": "deny",
    "harness review level medium *": "deny",
    "harness review level high *": "deny",
    "gh pr merge *": "ask",
    "git worktree remove --force *": "ask",
    "git worktree remove -f *": "ask"
  }
}
